local sockets = load("sockets")

local SERVER_ADDRESS = ("127.0.0.1", 8844)

try => {
  local sock = sockets.Socket(type=sockets.Socket.SOCK_DGRAM)
  while true => {
    print("\nMsg: ")
    sock.sendto(readline().bytes(), SERVER_ADDRESS)
    local data = sock.recvfrom()
    println(data[0].string())
  }
} catch "Interrupt" :_ => {}
