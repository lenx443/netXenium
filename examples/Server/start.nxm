load("config")

var http_packet = load("http_packet")
var http_server = load("http_server")

var WEB_PATH = ("./www")

var get_routes = {
  ['/'] => (req) {
    return http_packet.HTTPResponse.from_file(
      WEB_PATH + "/index.html"
    )
  },
  _ => (req) {
    return http_packet.HTTPResponse.from_file(
      WEB_PATH + req.path,
      error=WEB_PATH + "/not_found.html"
    )
  }
}

var methods = {
  GET -> get_routes
}

$$__start = async => {
  try => {
    println("• Start Server")
    local server = http_server.HTTPServer()
    server.set_routes(methods)
    await server.start(debug=true)
  } catch "Interrupt" :_ => {
    println("• Stop Server")
  }
}
